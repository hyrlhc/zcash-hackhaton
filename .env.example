# Copy to .env and fill in. Never commit .env.

# Zaino indexer (replaces lightwalletd). Local Z3 stack default.
ZAINO_URL=http://127.0.0.1:8137

# Zebra JSON-RPC, used to authenticate anchors against block state.
ZEBRA_RPC_URL=http://127.0.0.1:8232

# Which pool's note commitment tree anchors are accepted: orchard | ironwood
ZCLAIM_POOL=ironwood

# Merchant address used by the demo verifier (public data).
ZCLAIM_DEMO_MERCHANT_ADDRESS=

# Verifier domain separator. Must be unique per application; it is what stops
# a proof issued to one verifier from being replayed at another.
ZCLAIM_VERIFIER_DOMAIN=quantum-cafe-demo

# NOTE: no spending key, seed phrase, viewing key or holder secret belongs in
# this file or anywhere else in the repo. Witness material stays client-side.
